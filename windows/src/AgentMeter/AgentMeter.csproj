<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <WindowsSdkPackageVersion>10.0.19041.57</WindowsSdkPackageVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>2.1.3</Version>
    <AssemblyVersion>2.1.3.0</AssemblyVersion>
    <FileVersion>2.1.3.0</FileVersion>
    <Product>Llumi</Product>
    <AssemblyName>Llumi</AssemblyName>
    <RootNamespace>AgentMeter</RootNamespace>
    <Description>Remaining AI coding subscription allowances in the Windows notification area.</Description>
    <ApplicationIcon>Assets/Llumi.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets/Llumi.ico" />
    <EmbeddedResource Include="../../../assets/brand/llumi-dark.png" LogicalName="AgentMeter.Assets.Llumi.png" />
    <EmbeddedResource Include="Assets/*.svg" />
    <EmbeddedResource Include="Assets/SetupGuides/*.gif" />
    <EmbeddedResource Include="Assets/SetupGuides/*.png" />
    <EmbeddedResource Include="../../../site/windows-2.1.3-preview.json" LogicalName="AgentMeter.ReleaseNotes.json" />
    <ProjectReference Include="../AgentMeter.Core/AgentMeter.Core.csproj" />
  </ItemGroup>
</Project>
